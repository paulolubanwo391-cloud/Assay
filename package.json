{
  "name": "assay-near",
  "version": "1.0.0",
  "private": true,
  "description": "Assay: NEAR's income statement, measured from the chain. A re-runnable investment thesis with a security-budget lens.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && next build",
    "start": "node init && npx --yes serve out -l 4173",
    "fetch": "tsx pipeline/fetch.ts",
    "compute": "tsx pipeline/compute.ts",
    "validate": "tsx pipeline/validate.ts",
    "thesis": "tsx pipeline/thesis.ts",
    "rebuild": "npm run fetch && npm run compute && npm run validate && npm run thesis",
    "rebuild:offline": "npm run compute && npm run validate && npm run thesis",
    "model": "tsx pipeline/model-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "all": "npm run rebuild && npm test && npm run build",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "lenis": "^1.3.27",
    "motion": "^14.13.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "postcss": "^8.5.32",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
